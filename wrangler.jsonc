{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skrobot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Keep the generated workers.dev subdomain enabled: the shipped native app and
  // eas.json point at skrobot.me-d6a.workers.dev. Without this, every deploy
  // disables that subdomain (wrangler default) and the WebView shell 404s.
  "workers_dev": true,

  "routes": [
    {
      "pattern": "app.skaterobot.com",
      "custom_domain": true
    }
  ],

  // Per-IP throttle for /api/live-token (Workers rate limiting binding).
  // Best-effort and per-colo, which is fine for abuse damping. A legit voice
  // session mints 1 token plus up to 4 reconnect retries, so 10/min is roomy.
  "unsafe": {
    "bindings": [
      {
        "name": "LIVE_TOKEN_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skrobot",
      "database_id": "995891c7-f3bd-4c4b-837d-ff61d70c9874",
      "migrations_dir": "migrations"
    }
  ],

  // `remote` lets `npm run preview` use the real Email Service instead of the
  // local no-op binding. Plain `next dev` deliberately exposes a dev link.
  "send_email": [{ "name": "EMAIL", "remote": true }],

  "vars": {
    "MAGIC_LINK_FROM": "skaterobot@customrouter.ai",
    "ANALYTICS_ADMIN_EMAIL": "me@therealpablo.com"
  }

  // Secrets:
  //   production →  npx wrangler secret put GEMINI_API_KEY
  //   local preview (`npm run preview`) → put GEMINI_API_KEY=... in .dev.vars
  // Billing is intentionally disabled for beta. See docs/BILLING_ENABLEMENT.md.
}
