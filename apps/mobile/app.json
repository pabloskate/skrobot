{
  "expo": {
    "name": "Skate Robot",
    "slug": "skate-robot-mobile",
    "scheme": "skrobot",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "./plugins/withSkrobotNativeParity",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3f2f6",
          "image": "./assets/splash-mascot.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.mycompany.skaterobot",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Skate Robot uses the microphone for hands-free voice games.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.skaterobot.mobile",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f3f2f6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "adc228ce-29e2-446c-927e-7728eb623c96"
      }
    }
  }
}
