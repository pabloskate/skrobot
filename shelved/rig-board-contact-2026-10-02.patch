+/// <reference types="node" />
+import process from 'node:process';
+import { it } from 'vitest';
+import { resolveSkateStyle } from '../skateStyle';
+import type { RiderStance, Robot, Trick, Stance } from '../types';
+import { planStage, stageFrame } from './stage';
+import { legBoardCollision } from './boardCollision';
+import { kneeBetween } from '../scene/grindRig';
+import { moveFrame, type LegRig, type BoardRig } from '../scene/skeleton';
+import type { FallVariant } from '../TrickAnimation';
+
+const robot: Robot = { id: 'r', name: 'r', avatar: { body: '#7ec8e3', accent: '#e05c7a', variant: 0 }, skateStyle: { popHeight: 0.92, rotationSpeed: 1.08, flickStrength: 0.95 } };
+const BASES = ['Ollie','Ollie North','Kickflip','Heelflip','Double Kickflip','Double Heelflip','Varial Kickflip','Varial Heelflip','Hardflip','Inward Heelflip','Pressure Flip','Dolphin Flip','360 Flip','360 Double Kickflip','Laser Flip','Pop Shuvit','Frontside Shuvit','Late Backside Shuvit','Late Frontside Shuvit','Late Kickflip','360 Shuvit','Frontside 360 Shuvit','Bigspin','FS Bigspin','Bigspin Flip','FS Bigspin Flip','Bigspin Heelflip','FS Bigspin Heelflip','Frontside 180','Backside 180','Backside Flip','Frontside Flip','Backside Heelflip','Frontside Heelflip','Backside 360','Frontside 360','Backside 360 Kickflip','Frontside 360 Kickflip','Impossible','Frontside 50-50 Grind','Backside 5-0 Grind','Kickflip into Backside Boardslide','Backside 180 into Frontside Nosegrind'];
+const hits = (b: BoardRig, l: LegRig) => { const c = legBoardCollision(b, l); return c.shoe || c.shin || c.thigh; };
+const lifted = (l: LegRig, h: number): LegRig => { const by = { x: 0, y: -h, z: 0 }; const ankle = { x: l.ankle.x, y: l.ankle.y - h, z: l.ankle.z }; return { ...l, ankle, knee: kneeBetween(l.hip, ankle, l.knee), shoe: moveFrame(l.shoe, by) }; };
+const depth = (b: BoardRig, l: LegRig) => { if (!hits(b, l)) return 0; let lo = 0, hi = 80; for (let i = 0; i < 16; i++) { const m = (lo + hi) / 2; if (hits(b, lifted(l, m))) lo = m; else hi = m; } return hi; };
+const MODE = process.env.PROBE_MODE ?? 'landed';
+it('probe', () => {
+  const style = resolveSkateStyle(robot.skateStyle);
+  const rows: string[] = [];
+  let total = 0;
+  const outcomes: Array<[boolean, FallVariant]> = MODE === 'falls' ? [[false, 'slam'], [false, 'bail'], [false, 'shank']] : [[true, 'slam']];
+  const stances: Stance[] = MODE === 'stances' ? ['regular', 'fakie', 'switch', 'nollie'] : ['regular'];
+  for (const base of BASES) for (const stance of stances) for (const riderStance of ['regular', 'goofy'] as RiderStance[]) for (const [landed, fall] of outcomes) {
+    const trick: Trick = { id: base, name: base, base, stance };
+    const stage = planStage(robot, trick, { landed, riderStance, style, fall, shankProgress: 0.65 });
+    let hit = 0, worst = 0, worstT = 0, jump = 0, jumpT = 0, kj = 0, kjT = 0; const parts = { shoe: 0, shin: 0, thigh: 0 };
+    let prev: ReturnType<typeof stageFrame> | null = null;
+    for (let t = 0; t <= stage.end; t += 1 / 120) {
+      const fr = stageFrame(stage, t, 1);
+      const { rig } = fr;
+      let any = false;
+      rig.legs.forEach((leg, i) => {
+        const c = legBoardCollision(rig.board, leg);
+        if (c.shoe) parts.shoe++; if (c.shin) parts.shin++; if (c.thigh) parts.thigh++;
+        if (c.shoe || c.shin || c.thigh) { any = true; const d = depth(rig.board, leg); if (d > worst) { worst = d; worstT = t; } }
+        if (prev) { const k = prev.rig.legs[i].knee; const kd = Math.hypot(k.x - leg.knee.x, k.y - leg.knee.y, k.z - leg.knee.z); if (kd > kj) { kj = kd; kjT = t; } const p = prev.rig.legs[i].ankle; const dd = Math.hypot(p.x - leg.ankle.x, p.y - leg.ankle.y, p.z - leg.ankle.z); if (dd > jump) { jump = dd; jumpT = t; } }
+      });
+      prev = fr;
+      if (any) hit++;
+    }
+    total += hit;
+    if (worst > 0.5 || jump > 8 || kj > 8) rows.push(`${(base + ' ' + stance).padEnd(44)} ${riderStance.padEnd(6)} ${landed ? 'land' : fall.padEnd(5)} hit=${String(hit).padStart(3)} S${parts.shoe} N${parts.shin} T${parts.thigh} worst=${worst.toFixed(1)}@${worstT.toFixed(2)} jump=${jump.toFixed(1)}@${jumpT.toFixed(2)} knee=${kj.toFixed(1)}@${kjT.toFixed(2)}`);
+  }
+  console.log(`PROBE total hit frames=${total}\n` + rows.join('\n'));
+}, 600000);
