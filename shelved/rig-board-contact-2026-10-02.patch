+import { it } from 'vitest';
+import { resolveSkateStyle } from '../skateStyle';
+import type { Robot, Trick } from '../types';
+import { planStage, stageFrame } from './stage';
+import type { V3 } from '../scene/math';
+
+const robot: Robot = { id: 'r', name: 'r', avatar: { body: '#7ec8e3', accent: '#e05c7a', variant: 0 }, skateStyle: { popHeight: 0.92, rotationSpeed: 1.08, flickStrength: 0.95 } };
+const d = (a: V3, b: V3) => Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z);
+it('smooth', () => {
+  const style = resolveSkateStyle(robot.skateStyle);
+  const env = (globalThis as unknown as { process: { env: Record<string, string | undefined> } }).process.env;
+  const base = env.TRACE ?? 'Kickflip';
+  const [a, b, dt] = (env.WIN ?? '0.54,0.70,0.008333').split(',').map(Number);
+  const trick: Trick = { id: base, name: base, base, stance: 'regular' };
+  const stage = planStage(robot, trick, { landed: true, riderStance: 'regular', style, fall: 'slam', shankProgress: 0.65 });
+  const rows: string[] = [];
+  let prev = stageFrame(stage, a - dt, 1).rig;
+  for (let t = a; t <= b; t += dt) {
+    const { rig } = stageFrame(stage, t, 1);
+    const cells = rig.legs.map((l, i) => {
+      const p = prev.legs[i];
+      return `${l.flicking ? 'F' : 'B'} ank${d(l.ankle, p.ankle).toFixed(1).padStart(5)} knee${d(l.knee, p.knee).toFixed(1).padStart(5)} toe${d(l.shoe.at(12, 0, 0), p.shoe.at(12, 0, 0)).toFixed(1).padStart(5)}`;
+    }).join(' | ');
+    rows.push(`t=${t.toFixed(3)} pitch=${rig.board.pitchDeg.toFixed(1).padStart(6)} boardΔ${d(rig.board.point({ x: -48, y: 0, z: 0 }), prev.board.point({ x: -48, y: 0, z: 0 })).toFixed(1).padStart(5)} hipΔ${d(rig.legs[0].hip, prev.legs[0].hip).toFixed(1).padStart(5)} | ${cells}`);
+    prev = rig;
+  }
+  console.log(base + '\n' + rows.join('\n'));
+}, 600000);
