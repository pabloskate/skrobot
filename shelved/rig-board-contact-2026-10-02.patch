+/// <reference types="node" />
+import process from 'node:process';
+import { it } from 'vitest';
+import { resolveSkateStyle } from '../skateStyle';
+import type { Robot, Trick } from '../types';
+import { planStage, stageFrame } from './stage';
+import { capsuleIntersectsBoard } from './boardCollision';
+import { roundedBoxGeometry } from './geometry';
+import { dot3, sub3, rotY, rotZ } from '../scene/math';
+import { soleDepth } from '../scene/boardVolume';
+
+const robot: Robot = { id: 'r', name: 'r', avatar: { body: '#7ec8e3', accent: '#e05c7a', variant: 0 }, skateStyle: { popHeight: 0.92, rotationSpeed: 1.08, flickStrength: 0.95 } };
+it('trace', () => {
+  const style = resolveSkateStyle(robot.skateStyle);
+  const [base, ts, legIdx] = (process.env.TRACE ?? 'Double Heelflip@0.70@F').split('@');
+  const trick: Trick = { id: base, name: base, base, stance: 'regular' };
+  const stage = planStage(robot, trick, { landed: true, riderStance: 'regular', style, fall: 'slam', shankProgress: 0.65 });
+  const { rig } = stageFrame(stage, Number(ts), 1);
+  const leg = rig.legs.find((l) => (legIdx === 'F') === l.flicking)!;
+  const b = rig.board;
+  const un = (v: { x: number; y: number; z: number }) => rotY(rotZ(v, b.pitchDeg), b.yawDeg);
+  const deck = { origin: b.point({ x: 0, y: 0, z: 0 }), along: un({ x: 1, y: 0, z: 0 }), down: un({ x: 0, y: 1, z: 0 }), across: un({ x: 0, y: 0, z: 1 }), rollDeg: b.flipDeg };
+  console.log(`soleDepth sweep0=${soleDepth(deck, leg.shoe, { roll: 0, spin: 0 }).toFixed(2)} sweep1=${soleDepth(deck, leg.shoe, { roll: 1, spin: 0 }).toFixed(2)} flip=${b.flipDeg.toFixed(1)} shoeUp·deckUp=${(-dot3(leg.shoe.up, deck.down)).toFixed(2)}`);
+  const g = roundedBoxGeometry({ f: 12, u: 4, s: 6, r: 3.6 }, 4);
+  const pos = g.getAttribute('position');
+  const inside: string[] = [];
+  for (let i = 0; i < pos.count; i++) {
+    const p = leg.shoe.at(pos.getX(i), pos.getY(i), pos.getZ(i));
+    if (capsuleIntersectsBoard(b, p, p, 0.05)) {
+      const rel = sub3(p, deck.origin);
+      inside.push(`shoeLocal(${pos.getX(i).toFixed(1)},${pos.getY(i).toFixed(1)},${pos.getZ(i).toFixed(1)}) deck(${dot3(rel, deck.along).toFixed(1)},${(-dot3(rel, deck.down)).toFixed(1)},${dot3(rel, deck.across).toFixed(1)})`);
+    }
+  }
+  console.log(`inside ${inside.length}/${pos.count}\n` + inside.slice(0, 30).join('\n'));
+}, 600000);
