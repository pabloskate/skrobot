+/// <reference types="node" />
+import process from 'node:process';
+import { it } from 'vitest';
+import { resolveSkateStyle } from '../skateStyle';
+import type { Robot, Trick } from '../types';
+import { planStage, stageFrame } from './stage';
+import { legBoardCollision } from './boardCollision';
+import { dot3, sub3 } from '../scene/math';
+
+const robot: Robot = { id: 'r', name: 'r', avatar: { body: '#7ec8e3', accent: '#e05c7a', variant: 0 }, skateStyle: { popHeight: 0.92, rotationSpeed: 1.08, flickStrength: 0.95 } };
+it('trace', () => {
+  const style = resolveSkateStyle(robot.skateStyle);
+  for (const spec of (process.env.TRACE ?? 'Double Heelflip@0.66-0.74,Frontside 360 Shuvit@0.63-0.71').split(',')) {
+    const [base, win] = spec.split('@'); const [a, b] = win.split('-').map(Number);
+    const trick: Trick = { id: base, name: base, base, stance: 'regular' };
+    const stage = planStage(robot, trick, { landed: true, riderStance: 'regular', style, fall: 'slam', shankProgress: 0.65 });
+    const rows: string[] = [];
+    for (let t = a; t <= b; t += 1 / 240) {
+      const { rig } = stageFrame(stage, t, 1);
+      const o = rig.board.point({ x: 0, y: 0, z: 0 });
+      const cells = rig.legs.map((l) => {
+        const c = legBoardCollision(rig.board, l);
+        const rel = sub3(l.shoe.origin, o);
+        const bx = dot3(rel, rig.board.dir({ x: 1, y: 0, z: 0 }));
+        const bz = dot3(rel, rig.board.dir({ x: 0, y: 0, z: 1 }));
+        const bu = dot3(rel, rig.board.dir({ x: 0, y: -1, z: 0 }));
+        return `${l.flicking ? 'F' : 'B'}${c.shoe ? 'S' : '.'}${c.shin ? 'N' : '.'}${c.thigh ? 'T' : '.'} shoe@board(${bx.toFixed(1)},${bu.toFixed(1)},${bz.toFixed(1)})`;
+      });
+      rows.push(`t=${t.toFixed(4)} flip=${rig.board.flipDeg.toFixed(0)} yaw=${rig.board.yawDeg.toFixed(0)} pitch=${rig.board.pitchDeg.toFixed(1)} | ${cells.join(' | ')}`);
+    }
+    console.log(base + '\n' + rows.join('\n'));
+  }
+}, 600000);
