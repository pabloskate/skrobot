+import { HANGER_BOTTOM, WHEEL_HALF_W, WHEEL_INNER, WHEEL_R, WHEEL_X, WHEEL_Y, WHEEL_Z } from './board';
+import { BOTTOM_LOCAL, TIP_X, TOP_LOCAL, deckBottomY, deckTopY } from './deck';
+import { dot3, rad, sub3, type V3 } from './math';
+import { DECK_HALF_WIDTH, SHOE_HALF_HEIGHT, SHOE_HALF_LENGTH, SHOE_HALF_WIDTH, SHOE_ROUND, type Frame3 } from './skeleton';
+
+/**
+ * The skateboard as a solid the rider has to stay out of.
+ *
+ * The rig places the board and the feet from the shared physics, which was
+ * drawn side-on: there the deck is a line, and a flip only squashes it. In
+ * the round the deck is a slab as wide as a shoe is long, and rolling it
+ * swings its rails and then its trucks and wheels up through the space over
+ * the grip. So the rider's feet ride on the board's real volume (sized to the
+ * widest board drawn, Board3D's) rather than on a line.
+ *
+ * The volume is described the way it moves in a flip: as cross-sections
+ * about the roll axis (board-local x through the origin, y down), one per
+ * station along the board.
+ */
+
+/** Board3D draws its deck and axles this much wider than the SVG board. */
+export const BOARD_WIDTH_SCALE = 1.2;
+
+/** The 3D deck's half-width at `x` along it, rounding off at the tips. */
+export function boardHalfWidth(x: number): number {
+  const start = TIP_X - 9.5;
+  const u = Math.max(0, (Math.abs(x) - start) / 9.5);
+  return u >= 1 ? 0 : DECK_HALF_WIDTH * BOARD_WIDTH_SCALE * Math.sqrt(1 - u * u);
+}
+
+/** Board-local points that must stay on or above the ground: the deck's outline and every wheel's rim. */
+export const BOARD_HULL: readonly V3[] = (() => {
+  const pts: V3[] = [...TOP_LOCAL, ...BOTTOM_LOCAL];
+  for (const x of [-WHEEL_X, WHEEL_X]) {
+    for (const z of [-WHEEL_Z, WHEEL_Z]) {
+      for (let k = 0; k < 16; k++) {
+        const a = (k / 16) * Math.PI * 2;
+        pts.push({ x: x + Math.sin(a) * WHEEL_R, y: WHEEL_Y + Math.cos(a) * WHEEL_R, z });
+      }
+    }
+  }
+  return pts;
+})();
+
+/** One box of a cross-section: across z0..z1, board-local y0..y1 (y down). */
+interface Section { z0: number; z1: number; y0: number; y1: number }
+
+/** Half-length of a truck along the board: its baseplate. */
+const TRUCK_HALF_LENGTH = 4.2;
+
+/** The board's cross-section at `x`: the deck, and over a truck its hanger and wheels. */
+function sections(x: number): Section[] {
+  const s = BOARD_WIDTH_SCALE;
+  const out: Section[] = [];
+  const half = boardHalfWidth(x);
+  if (half > 0) out.push({ z0: -half, z1: half, y0: deckTopY(x), y1: deckBottomY(x) });
+  for (const axle of [-WHEEL_X, WHEEL_X]) {
+    const dx = Math.abs(x - axle);
+    if (dx < TRUCK_HALF_LENGTH) out.push({ z0: -WHEEL_INNER * s, z1: WHEEL_INNER * s, y0: deckBottomY(x), y1: HANGER_BOTTOM });
+    if (dx < WHEEL_R) {
+      const r = Math.sqrt(WHEEL_R * WHEEL_R - dx * dx);
+      for (const side of [-1, 1]) {
+        const z = side * WHEEL_Z * s;
+        out.push({ z0: z - WHEEL_HALF_W * s, z1: z + WHEEL_HALF_W * s, y0: WHEEL_Y - r, y1: WHEEL_Y + r });
+      }
+    }
+  }
+  return out;
+}
+
+/**
+ * The highest point of a box rolled by (cos, sin) over the strip z0..z1 of
+ * the unrolled frame, as unrolled y (y down); Infinity if the strip misses
+ * it. A rolled point (y, z) sits at Y = y·cos − z·sin, Z = y·sin + z·cos
+ * (scene/math rotX). The top of a convex outline over a strip peaks at one
+ * of its corners or at an end of the strip.
+ */
+function stripTop(box: Section, cos: number, sin: number, z0: number, z1: number): number {
+  let top = Infinity;
+  for (const y of [box.y0, box.y1]) {
+    for (const z of [box.z0, box.z1]) {
+      const at = y * sin + z * cos;
+      if (at >= z0 && at <= z1) top = Math.min(top, y * cos - z * sin);
+    }
+  }
+  for (const z of [z0, z1]) {
+    // The vertical line at z: keep min ≤ k·Y + offset ≤ max for both of the box's bands.
+    let lo = -Infinity;
+    let hi = Infinity;
+    const band = (k: number, offset: number, min: number, max: number) => {
+      if (Math.abs(k) < 1e-9) {
+        if (offset < min || offset > max) lo = Infinity;
+        return;
+      }
+      lo = Math.max(lo, Math.min((min - offset) / k, (max - offset) / k));
+      hi = Math.min(hi, Math.max((min - offset) / k, (max - offset) / k));
+    };
+    band(cos, z * sin, box.y0, box.y1);
+    band(-sin, z * cos, box.z0, box.z1);
+    if (lo <= hi) top = Math.min(top, lo);
+  }
+  return top;
+}
+
+/**
+ * How far each station's cross-section reaches from the roll axis: the
+ * cylinder a roll sweeps. Eased along the board (never below the true reach)
+ * so a foot sliding past a truck rises over its wheels instead of stepping.
+ */
+const SWEEP_EASE = 0.7;
+const SWEEP_STEP = 1;
+const SWEEP: readonly number[] = (() => {
+  const reach: number[] = [];
+  for (let x = -TIP_X; x <= TIP_X + 1e-9; x += SWEEP_STEP) {
+    let r = 0;
+    for (const box of sections(x)) {
+      for (const y of [box.y0, box.y1]) for (const z of [box.z0, box.z1]) r = Math.max(r, Math.hypot(y, z));
+    }
+    reach.push(r);
+  }
+  return reach.map((_, i) => Math.max(...reach.map((r, j) => r - SWEEP_EASE * SWEEP_STEP * Math.abs(i - j))));
+})();
+
+function sweptRadius(x: number): number {
+  const i = (Math.max(-TIP_X, Math.min(TIP_X, x)) + TIP_X) / SWEEP_STEP;
+  const i0 = Math.max(0, Math.min(SWEEP.length - 2, Math.floor(i)));
+  const u = Math.max(0, Math.min(1, i - i0));
+  return SWEEP[i0] + (SWEEP[i0 + 1] - SWEEP[i0]) * u;
+}
+
+/**
+ * The unrolled board: the roll axis's origin, the board's axes before its
+ * roll (pitch and yaw only), and the roll (deg). The rider's feet keep to
+ * this frame through a flip, as a rider's feet follow the board's pitch and
+ * heading while it rolls beneath them.
+ */
+export interface DeckFrame {
+  origin: V3;
+  along: V3;
+  down: V3;
+  across: V3;
+  rollDeg: number;
+}
+
+/**
+ * How much of the board's motion the feet stay clear of, ahead of time
+ * (each 0 → 1): `roll`, the cylinder a flip's rolling rails, trucks and
+ * wheels sweep about the board's long axis; `spin`, the disc a shuvit's
+ * deck sweeps turning under the feet (and with a roll, that cylinder turned
+ * round with it). The rider lifts out of the way before the board comes
+ * round, not as it arrives.
+ */
+export interface BoardSweep {
+  roll: number;
+  spin: number;
+}
+
+const STILL: BoardSweep = { roll: 0, spin: 0 };
+
+/** The rounded sole, sampled over its whole footprint: shoe-local (fwd, up, side). */
+const SOLE_STEP = 3;
+const SOLE: ReadonlyArray<{ f: number; u: number; s: number }> = (() => {
+  const pts: Array<{ f: number; u: number; s: number }> = [];
+  for (let f = -SHOE_HALF_LENGTH; f <= SHOE_HALF_LENGTH + 1e-9; f += SOLE_STEP) {
+    for (let s = -SHOE_HALF_WIDTH; s <= SHOE_HALF_WIDTH + 1e-9; s += SOLE_STEP) {
+      const df = Math.max(0, Math.abs(f) - (SHOE_HALF_LENGTH - SHOE_ROUND));
+      const ds = Math.max(0, Math.abs(s) - (SHOE_HALF_WIDTH - SHOE_ROUND));
+      const r2 = SHOE_ROUND * SHOE_ROUND - df * df - ds * ds;
+      if (r2 >= 0) pts.push({ f, u: -(SHOE_HALF_HEIGHT - SHOE_ROUND + Math.sqrt(r2)), s });
+    }
+  }
+  return pts;
+})();
+/** Each sole sample stands for the strip of the board half a step either side of it, so nothing slips between them. */
+const STRIP = SOLE_STEP / 2 + 0.1;
+
+/**
+ * How far the sole is into the board along the deck's up (positive), or
+ * clear of it (negative); -Infinity when no part of the shoe is over the
+ * board or within its sweep.
+ */
+export function soleDepth(deck: DeckFrame, shoe: Frame3, sweep: BoardSweep = STILL): number {
+  const cos = Math.cos(rad(deck.rollDeg));
+  const sin = Math.sin(rad(deck.rollDeg));
+  let depth = -Infinity;
+  for (const p of SOLE) {
+    const rel = sub3(shoe.at(p.f, p.u, p.s), deck.origin);
+    const x = dot3(rel, deck.along);
+    const z = dot3(rel, deck.across);
+    let top = Infinity;
+    if (Math.abs(x) <= TIP_X) {
+      for (const box of sections(x)) top = Math.min(top, stripTop(box, cos, sin, z - STRIP, z + STRIP));
+      const near = Math.max(0, Math.abs(z) - STRIP);
+      const r = sweptRadius(x);
+      if (sweep.roll > 0 && near < r) top = Math.min(top, -sweep.roll * Math.sqrt(r * r - near * near));
+    }
+    if (sweep.spin > 0) {
+      // Turning, the board passes every station within its length under the sole.
+      const reach = Math.max(0, Math.hypot(x, z) - STRIP);
+      if (reach <= TIP_X) top = Math.min(top, -sweep.spin * Math.max(-deckTopY(reach), sweep.roll * sweptRadius(reach)));
+    }
+    if (top < Infinity) depth = Math.max(depth, dot3(rel, deck.down) - top);
+  }
+  return depth;
+}
