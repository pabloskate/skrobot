+/// <reference types="node" />
+import process from 'node:process';
+import { it } from 'vitest';
+import { resolveSkateStyle } from '../skateStyle';
+import type { Robot, Trick } from '../types';
+import { planStage, stageFrame } from './stage';
+import { computeFrame } from '../TrickAnimation';
+
+const robot: Robot = { id: 'r', name: 'r', avatar: { body: '#7ec8e3', accent: '#e05c7a', variant: 0 }, skateStyle: { popHeight: 0.92, rotationSpeed: 1.08, flickStrength: 0.95 } };
+it('trace', () => {
+  const style = resolveSkateStyle(robot.skateStyle);
+  for (const base of (process.env.TRACE ?? 'Kickflip').split(',')) {
+    const trick: Trick = { id: base, name: base, base, stance: 'regular' };
+    const stage = planStage(robot, trick, { landed: true, riderStance: 'regular', style, fall: 'slam', shankProgress: 0.65 });
+    const rows: string[] = [];
+    const [a, b, dt] = (process.env.WIN ?? '0.54,0.64,0.005').split(',').map(Number);
+    for (let t = a; t <= b; t += dt) {
+      const { rig } = stageFrame(stage, t, 1);
+      const f = computeFrame(t, stage.spec, true, 'slam', 0.65, style);
+      const legs = rig.legs.map((l) => `${l.flicking ? 'F' : 'B'} ank=(${l.ankle.x.toFixed(1)},${l.ankle.y.toFixed(1)},${l.ankle.z.toFixed(1)}) hip.y=${l.hip.y.toFixed(1)}`).join(' | ');
+      rows.push(`t=${t.toFixed(3)} rot=${f.board.rot.toFixed(1)} pitch=${rig.board.pitchDeg.toFixed(1)} flip=${rig.board.flipDeg.toFixed(0)} cy=${rig.board.center.y.toFixed(1)} fby=${f.board.y.toFixed(1)} | ${legs}`);
+    }
+    console.log(base + '\n' + rows.join('\n'));
+  }
+}, 600000);
